{
  "expo": {
    "name": "strider",
    "slug": "strider",
    "scheme": "strider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.strider.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "채팅 사진을 갤러리에 저장하기 위해 사진 라이브러리 접근이 필요합니다.",
        "NSCameraUsageDescription": "피드에 사진과 동영상을 촬영하기 위해 카메라 접근이 필요합니다.",
        "NSMicrophoneUsageDescription": "동영상 촬영 시 마이크 접근이 필요합니다.",
        "NSHealthShareUsageDescription": "건강 데이터를 분석하여 맞춤 AI 리포트를 제공합니다.",
        "NSHealthUpdateUsageDescription": "건강 데이터를 기록합니다.",
        "NSPhotoLibraryAddUsageDescription": "채팅에서 받은 사진을 갤러리에 저장합니다.",
        "LSApplicationQueriesSchemes": [
          "kakaokompassauth",
          "kakaolink",
          "kakaotalk",
          "naversearchapp",
          "naversearchthirdlogin"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.strider.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "피드에 사진을 업로드하기 위해 사진 라이브러리 접근이 필요합니다.",
          "savePhotosPermission": "촬영한 사진을 저장하기 위해 접근이 필요합니다.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "router": {}
    }
  }
}
