# 본인이 소유한 서비스 설정을 입력하세요. 실제 값은 커밋하지 마세요.
APP_IDENTIFIER=com.strider.app
KAKAO_NATIVE_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 서버 주소는 예시입니다. 본인의 백엔드·미디어 서버로 변경하세요.
API_BASE_URL=https://api.example.com
CHAT_WEBSOCKET_URL=wss://api.example.com/ws-chat
MEDIA_BASE_URL=https://media.example.com
SHARE_BASE_URL=https://app.example.com

# iOS HealthKit 동기화는 설정·권한 확인 후 켜세요.
HEALTH_SYNC_ENABLED=false
# 테스트 건강 데이터 전송은 별도 테스트 서버에서만 사용하세요.
DEMO_HEALTH_ENABLED=false
